    "algorithm": {
      "input": "accentHue (HAPulse-Regler) → accent = hsl(h, 78 %, 50 %) hell / hsl(h, 78 %, 60 %) dunkel; ohne Hue: #FF9500 / #FF9F0A",
      "accentInk": "hell: RGB je Schritt × 0,9 bis Kontrast ≥ 4,5:1 auf #F2F2F7; dunkel: je Schritt 12 % Richtung Weiß bis ≥ 4,5:1 auf #1C1C1E (max. 40 Schritte)",
      "tabInk": "accentInk weiter abdunkeln (× 0,93) bzw. aufhellen (10 %) bis ≥ 4,5:1 auf der Linse (hell #E6E6E9, dunkel #3C3C3D)",
      "onProminent": "#1C1C1E, wenn Kontrast zum Akzent ≥ 4,5:1; sonst #FFFFFF, wenn ≥ 4,5:1; sonst prominent = accentInk mit #FFFFFF",
      "accentSoft": "Akzent mit Alpha .16 (hell) / .26 (dunkel)",
      "note": "Handy-Skizze: Orange-Ink #B25000 + separat berechnete Tab-Ink; Desktop-Skizze: #A64B00. #B25000 hat auf der Tab-Linse nur 4,17:1 → verbindlich #A64B00 als accentInk. #B25000 bleibt orangeInk (Heizen)."
    }
  },
  "glass": {
    "description": "Liquid-Glass-Nachbau ohne SVG-Refraktion (Safari-tauglich). Nur Funktionsebene. Rezept = Füllung (padding-box) + backdrop-filter + Rand (::before, 1 px, Maske xor/exclude) + Dicke/Linse (box-shadow) + Glanz bei Druck (::after).",
    "tintVar": "--g-glass-tint",
    "strength": {
      "klar": {
        "tint": 0.25,
        "attr": "data-glass=\"clear\"",
        "note": "Standard (Plan §1.1: 'clear')"
      },
      "getoent": {
        "tint": 0.75,
        "attr": "data-glass=\"tinted\""
      },
      "deckend": {
        "attr": "data-glass=\"opaque\"",
        "fill": "var(--g-card-solid)",
        "filter": "none",
        "rim": "none",
        "shadow": "0 0 0 1px var(--g-sep-strong), 0 10px 30px rgba(0,0,0,.12)",
        "clearFill": "rgba(0,0,0,.72)",
        "clearShadow": "0 0 0 1px rgba(255,255,255,.35)",
        "sheetFill": "var(--g-sheet-solid)",
        "label2Light": "#3A3A3C",
        "label2Dark": "#D1D1D6",
        "sepLight": "rgba(60,60,67,.36)",
        "sepDark": "rgba(84,84,88,.9)",
        "note": "Wird auch bei 'Transparenz reduzieren' (GLOBAL, Admin, E2) erzwungen."
      }
    },
