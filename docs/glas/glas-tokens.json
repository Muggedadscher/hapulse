  "meta": {
    "name": "HAPulse Glas – Design-Tokens",
    "version": "1.0.0",
    "date": "2026-10-06",
    "description": "Maschinenlesbare Tokens des freigegebenen Stils Glas (Skizze Glas 5). Erklärung, Regeln und Kontrastmessungen: docs/GLAS-DESIGN.md. Architektur: docs/GLAS-PLAN.md.",
    "sources": [
      "docs/glas/skizze/Glas5Handy.dc.html (Helmet-CSS .g5-root, Skript)",
      "docs/glas/skizze/Glas5Desktop.dc.html (Helmet-CSS .gd5-root, Skript)",
      "docs/glas/spec/SPEC3.md §1/§2, SPEC4.md, SPEC5.md",
      "docs/GLAS-PLAN.md §1.3, §7.3"
    ],
    "conventions": {
      "cssPrefix": "Glas-eigene Variablen heißen --g-<name> (kebab-case des JSON-Schlüssels, z. B. yellowInk → --g-yellow-ink). Bestehende HAPulse-Namen siehe classicMapping.",
      "modes": "Jeder Farbwert hat light und dark. Dunkelmodus = reines Schwarz (#000000) mit #1C1C1E/#2C2C2E-Flächen.",
      "units": "px, s, ms wie angegeben; Alphawerte als rgba().",
      "canonical": "Wo Handy- und Desktop-Skizze leicht abweichen, ist der hier eingetragene Wert verbindlich; die Abweichung steht jeweils in 'note'."
    }
  },
