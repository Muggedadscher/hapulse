    "notes": {
      "label2": "Handy-Skizze #5F5F64, Desktop #5E5E63 → verbindlich #5F5F64 (Plan §1.3). Auf Glasflächen mit Text gilt --g-glass-label-2 (#3A3A3C / #D1D1D6) statt label2.",
      "label3": "#7C7C80 erreicht nur 3,73:1 auf #F2F2F7: nur für Chevrons/dekorative Glyphen (Grafik ≥ 3:1), nie für Text.",
      "textFaint": "Neuer Wert für HAPulse --text-faint (kleine Texte): hell #636366 (5,37:1 auf #F2F2F7), dunkel #A1A1A6 (5,42:1 auf #2C2C2E).",
      "yellowInk": "Handy #8F6C00 fällt auf #F2F2F7 (4,36:1) und auf yellowSoft (4,36:1) durch → verbindlich Desktop-Wert #7D5E00 (≥ 5,4:1).",
      "redInk": "Desktop #C70014, Handy #D70015 → verbindlich #D70015 (≥ 4,58:1 auf allen Flächen, Plan §1.3).",
      "tileOff": "Handy: color-mix(card 45 %, bg) = #F8F8FB; Desktop: #F2F2F7. Verbindlich Handy-Formel (ruhiger Unterschied zu tileOn).",
      "bannerLost": "Desktop-Skizze nutzte Vollton-Rot mit weißem Text (3,55:1, durchgefallen) → verbindlich die Handy-Mischung mit --g-label.",
      "switchOff": "Desktop-Skizze; Handy nutzte fill2. Verbindlich switchOff.",
      "semanticRule": "Farbe nur für echte Zustände. Glyphen/Text in Zustandsfarbe immer mit *Ink; Flächen (Kreise, Balken, Schalter) mit der Vollfarbe; Flächen-Tönung mit *Soft nur auf Karte/Gruppe (#FFFFFF bzw. #1C1C1E/#2C2C2E), nicht direkt auf dem Seitenhintergrund."
    }
