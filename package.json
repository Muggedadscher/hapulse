{
  "name": "hapulse",
  "private": true,
  "version": "1.3.2",
  "description": "A modern, themeable dashboard for Home Assistant.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jlnbln/HAPulse.git"
  },
  "workspaces": [
    "packages/core",
    "apps/dashboard"
  ],
  "scripts": {
    "dev": "npm run dev -w @hapulse/dashboard",
    "build": "npm run build -w @hapulse/core && npm run build -w @hapulse/dashboard",
    "typecheck": "npm run typecheck -w @hapulse/core && npm run typecheck -w @hapulse/dashboard",
    "test": "npm test -w @hapulse/core && npm test -w @hapulse/dashboard",
    "changelog": "npm run build -w @hapulse/core && node packages/core/scripts/gen-changelog.mjs",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.1"
  }
}
